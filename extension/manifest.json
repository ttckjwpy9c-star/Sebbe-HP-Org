{
  "manifest_version": 3,
  "name": "Ordtoppen Läsassistent",
  "version": "0.3.0",
  "description": "Markera ett ord och få en kort AI-förklaring direkt på webbsidan.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://hkijnyhmpcczihmnepww.supabase.co/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Ordtoppen Läsassistent",
    "default_popup": "popup.html"
  }
}
